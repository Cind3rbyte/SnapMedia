{
  "name": "snapmedia",
  "version": "1.0.0",
  "private": true,
  "description": "SnapMedia – 100% lokale, private Medien-Toolbox im Browser. Komprimieren, konvertieren, schneiden und Metadaten entfernen – ohne Upload.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-wasm-assets.mjs",
    "predev": "node scripts/copy-wasm-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "browser-image-compression": "2.0.2",
    "clsx": "2.1.1",
    "file-saver": "2.0.5",
    "geist": "1.9.0",
    "heic2any": "0.0.4",
    "jszip": "3.10.2",
    "lucide-react": "1.66.0",
    "next": "15.5.28",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/file-saver": "2.0.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
